# Copy to .env and edit. Nothing here is a secret.
#
# There is no API key. The Bedrock provider takes credentials from the standard
# AWS credential chain, so configure AWS access the way you normally do
# (`aws configure`, SSO, an instance role) and leave credentials out of this file.

# Region to run inference in. Must be one where your chosen model is available.
AWS_REGION=us-east-1

# Which model recipes should use: luna | terra | sol
#   luna  fast and cheap   terra  the default   sol  hardest reasoning
# Note sol is not served in us-west-2.
MODEL=terra

# Optional. Bedrock Project to attribute inference to. Inference is authorized on
# a Project ARN, so this is also the access-isolation boundary. Defaults to the
# account's `default` project when unset.
# BEDROCK_PROJECT_ID=proj_xxxxxxxxxxxxxxxxxxxx

# Required for 03-grounding-and-multimodal/04-rag-with-knowledge-bases.
# The 10-character ID of your Bedrock Knowledge Base (e.g. 78NVB3ZXQV).
# KNOWLEDGE_BASE_ID=XXXXXXXXXX
